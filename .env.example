# Recruitment stays disabled until protocol, consent, content and security review.
STUDY_ENABLED=false
# Five-course name/ERP recording remains off until its own approval gates are set.
COURSE_RECORDING_ENABLED=false
# Physical deletion remains disabled until retention/ethics approval is recorded.
PHYSICAL_DELETION_ENABLED=false
# Runtime login (visuallearn_app), never the migration owner or a superuser.
DATABASE_URL=
APP_BASE_URL=http://127.0.0.1:3000
# Generate at least 32 random bytes; never commit a populated file.
SESSION_SECRET=
# Researcher sign-in: Supabase Auth URL and anon (publishable) key only.
# No Supabase service-role key is used by the app or sent to browsers.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Comma-separated Supabase Auth user UUIDs allowed into /admin.
ADMIN_ALLOWLIST=
# TOTP MFA is always required in production. Only a local, non-production
# rehearsal may set ADMIN_REQUIRE_MFA=false.
CONTENT_VERSION=1.0.0-draft
PROTOCOL_VERSION=2.0.0-draft
FOLLOWUP_WINDOW_MINUTES=30
